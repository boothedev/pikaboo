{
  "name": "pikaboo",
  "version": "1.0.0",
  "description": "Discord points bot",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "dev:watch": "tsx watch --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --minify --format esm",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "discord",
    "bot",
    "points"
  ],
  "author": {
    "name": "Quang Pham",
    "email": "contact@boothedev.xyz"
  },
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "discord.js": "^14.27.0",
    "drizzle-orm": "1.0.0-rc.4",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@types/node": "^26.1.2",
    "drizzle-kit": "1.0.0-rc.4",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
